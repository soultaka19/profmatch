# ──────────────────────────────
# Base de données
# ──────────────────────────────
DATABASE_URL=postgresql+asyncpg://profmatch:profmatch@localhost:5432/profmatch
TEST_DATABASE_URL=postgresql+asyncpg://profmatch:profmatch@localhost:5432/profmatch_test

# ──────────────────────────────
# Redis / Celery
# ──────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_ALWAYS_EAGER=false

# ──────────────────────────────
# JWT
# ──────────────────────────────
SECRET_KEY=changez-moi-en-prod-32-caracteres-min
JWT_ALGORITHM=HS256
JWT_TTL_HOURS=24

# ──────────────────────────────
# API LLM (compétition)
# ──────────────────────────────
LLM_API_URL=https://...
LLM_API_COOKIE=...
LLM_API_KEY=
LLM_MODEL=gpt-oss-ctx24k:120b
LLM_MAX_RETRIES=2

# ──────────────────────────────
# Upload CV
# ──────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10

# ──────────────────────────────
# Frontend
# ──────────────────────────────
FRONTEND_URL=http://localhost:3000

# ──────────────────────────────
# Mode démo (jury) — false en prod
# ──────────────────────────────
DEMO_MODE=false
