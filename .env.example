# Modèle de configuration : copier en `.env` à la racine du projet.
# docker-compose.yml lit ce fichier (env_file) et surcharge DATABASE_URL,
# REDIS_URL, UPLOADS_DIR, CELERY_ALWAYS_EAGER et SEED_DEMO_ACCOUNTS_ON_START
# pour les conteneurs ; les valeurs ci-dessous servent surtout au lancement
# local hors Docker (uvicorn / celery / pytest depuis backend/).
# Attention : une variable numérique laissée vide (ex. JWT_TTL_HOURS=) fait
# échouer le démarrage (ValidationError) — supprimer la ligne ou la renseigner.

# ──────────────────────────────
# Ports publiés sur la machine hôte (docker compose)
# ──────────────────────────────
# Ne change QUE le port côté hôte : à l'intérieur du réseau compose, les
# services se joignent toujours par db:5432, redis:6379 et backend:8000.
# À modifier si un autre projet occupe déjà l'un de ces ports — un PostgreSQL
# local sur 5432 suffit à faire échouer `docker compose up`.
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# ──────────────────────────────
# Base de données PostgreSQL
# ──────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Format asyncpg : postgresql+asyncpg://user:motdepasse@localhost:5432/profmatch
DATABASE_URL=

# Base SÉPARÉE utilisée par pytest (le schéma est supprimé et recréé à chaque
# test : ne jamais pointer sur la base de développement).
# Ex. : postgresql+asyncpg://user:motdepasse@localhost:5432/profmatch_test
TEST_DATABASE_URL=

# ──────────────────────────────
# Redis / Celery
# ──────────────────────────────
REDIS_URL=redis://localhost:6379/0
# true = exécuter les tâches Celery dans le processus API (sans worker).
# Laisser false : l'upload CV et la génération d'affectations ne fonctionnent
# pas en mode eager (voir README, section Known limitations).
CELERY_ALWAYS_EAGER=false

# ──────────────────────────────
# Démo : créer les comptes prof/rh/admin au démarrage
# ──────────────────────────────
# Lu par backend/entrypoint.sh (Docker) : true = exécuter scripts/seed_demo.py
# après les migrations (idempotent, non bloquant). docker-compose.yml force
# "true" (mode démo/jury) ; mettre false en production. Hors Docker, lancer
# `python scripts/seed_demo.py` manuellement.
SEED_DEMO_ACCOUNTS_ON_START=false

# ──────────────────────────────
# JWT
# ──────────────────────────────
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_TTL_HOURS=24

# ──────────────────────────────
# API LLM (endpoint compatible OpenAI)
# ──────────────────────────────
# Le code n'appelle que /chat/completions avec temperature et max_tokens :
# ni tools, ni response_format. Tout fournisseur exposant l'API OpenAI convient.
#
# --- Configuration par défaut : Google Gemini -------------------------------
# Google expose une couche compatible OpenAI. Clé à créer sur
# https://aistudio.google.com/apikey (le palier gratuit suffit à la démo).
# gemini-2.5-flash n'est plus ouvert aux nouveaux comptes (404 « no longer
# available to new users ») : Google renvoie vers la génération 3.x.
# LLM_API_COOKIE reste VIDE : aucun cookie n'est alors envoyé.
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_COOKIE=
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
#
# --- Configuration d'origine : proxy CoCalc de la compétition La Cité -------
# Conservée pour mémoire ; l'accès n'est plus garanti hors compétition.
#   LLM_API_URL=<endpoint fourni par La Cité>
#   LLM_API_COOKIE=<jeton du proxy CoCalc>   # obligatoire pour CE fournisseur
#   LLM_API_KEY=<clé Bearer du modèle>
#   LLM_MODEL=gpt-oss-ctx24k:120b
LLM_MAX_RETRIES=2
# Timeout (secondes) de l'appel d'extraction CV. Défaut 90 — l'augmenter si
# le fournisseur est lent (ReadTimeout pendant l'extraction).
LLM_EXTRACTION_TIMEOUT_S=90
# Plafond de génération de l'extraction CV. Les modèles à raisonnement
# (Gemini 3.x) imputent leurs jetons de réflexion à ce plafond en plus du texte
# produit : mesuré à ~640 jetons de réflexion pour 160 de sortie sur un CV
# court. 4000 laisse la marge nécessaire ; 2000 suffit pour un modèle sans
# raisonnement. Trop bas = JSON tronqué, donc invalide, donc extraction en échec.
LLM_EXTRACTION_MAX_TOKENS=4000

# ──────────────────────────────
# Embeddings du score sémantique W4
# ──────────────────────────────
# Calculés par l'API du fournisseur, sur le même endpoint et la même clé que le
# LLM. Auparavant calculés localement par sentence-transformers, ce qui imposait
# PyTorch : 2 Go d'image et 632 Mo de mémoire dans le worker — au-delà des
# 512 Mo des paliers d'hébergement gratuits.
EMBEDDING_MODEL=gemini-embedding-001
# 384 = dimension native de l'ancien modèle local : aucun changement de schéma
# (les colonnes sont des double precision[] sans dimension fixe).
EMBEDDING_DIMENSIONS=384
#
# ⚠️ Changer EMBEDDING_MODEL ou EMBEDDING_DIMENSIONS invalide TOUS les vecteurs
# déjà stockés : deux modèles produisent des espaces vectoriels distincts, et
# les mélanger rend le score W4 dénué de sens sans lever la moindre erreur.
# Après un tel changement, rejouer :
#   POST /api/admin/maintenance/backfill-embeddings?force=true
# Timeout (secondes) de la narration XAI. Défaut 45 — baisser (ex. 30) pour une
# démo plus réactive, augmenter si l'API est lente et fallback trop fréquent.
LLM_XAI_TIMEOUT_S=45

# ──────────────────────────────
# Upload CV
# ──────────────────────────────
# Dossier de stockage des CV (volume /uploads en Docker)
UPLOADS_DIR=/uploads
# Taille max acceptée par POST /api/cv/upload (Mo)
MAX_UPLOAD_SIZE_MB=10

# ──────────────────────────────
# Frontend
# ──────────────────────────────
# Origine autorisée par CORS et base des liens d'activation envoyés par l'admin
# (http://localhost:3000 reste toujours accepté par CORS).
FRONTEND_URL=http://localhost:3000
