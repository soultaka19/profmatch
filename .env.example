# ──────────────────────────────
# Base de données PostgreSQL
# ──────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Pour les tests (base séparée)
TEST_DATABASE_URL=

# ──────────────────────────────
# Redis / Celery
# ──────────────────────────────
REDIS_URL=

# ──────────────────────────────
# Démo : créer les comptes prof/rh/admin au démarrage (true pour la démo jury)
# ──────────────────────────────
SEED_DEMO_ACCOUNTS_ON_START=false

# ──────────────────────────────
# JWT
# ──────────────────────────────
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_ALGORITHM=
JWT_TTL_HOURS=

# ──────────────────────────────
# API LLM — Compétition La Cité
# ──────────────────────────────
LLM_API_URL=
LLM_API_COOKIE=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_RETRIES=
# Timeout (secondes) de l'appel d'extraction CV. Défaut 90 — l'augmenter si
# l'API de la compétition est lente (ReadTimeout pendant l'extraction).
LLM_EXTRACTION_TIMEOUT_S=
# Timeout (secondes) de la narration XAI. Défaut 45 — baisser (ex. 30) pour une
# démo plus réactive, augmenter si l'API est lente et fallback trop fréquent.
LLM_XAI_TIMEOUT_S=

# ──────────────────────────────
# Upload CV
# ──────────────────────────────
UPLOAD_DIR=
UPLOADS_DIR=/uploads
MAX_UPLOAD_SIZE_MB=
CELERY_ALWAYS_EAGER=false
